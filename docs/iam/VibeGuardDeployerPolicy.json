{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2ReadOnlyDescribeUsEast1",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } }
    },
    {
      "Sid": "Ec2LaunchInstanceFreePlanTypesOnly",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:810995308548:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": ["t3.micro", "t3.small", "c7i-flex.large", "m7i-flex.large"],
          "aws:RequestTag/Project": "VibeGuard"
        }
      }
    },
    {
      "Sid": "Ec2LaunchSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:810995308548:subnet/*",
        "arn:aws:ec2:us-east-1:810995308548:security-group/*",
        "arn:aws:ec2:us-east-1:810995308548:network-interface/*",
        "arn:aws:ec2:us-east-1:810995308548:key-pair/vibeguard-*"
      ]
    },
    {
      "Sid": "Ec2LaunchEbsVolumeMax30GiB",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:810995308548:volume/*",
      "Condition": { "NumericLessThanEquals": { "ec2:VolumeSize": "30" } }
    },
    {
      "Sid": "Ec2TagResourcesOnlyAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:810995308548:instance/*",
        "arn:aws:ec2:us-east-1:810995308548:volume/*",
        "arn:aws:ec2:us-east-1:810995308548:security-group/*"
      ],
      "Condition": {
        "StringEquals": { "ec2:CreateAction": ["RunInstances", "CreateSecurityGroup"] }
      }
    },
    {
      "Sid": "Ec2CreateSecurityGroupInVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:810995308548:vpc/*"
    },
    {
      "Sid": "Ec2CreateTaggedSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:810995308548:security-group/*",
      "Condition": { "StringEquals": { "aws:RequestTag/Project": "VibeGuard" } }
    },
    {
      "Sid": "Ec2ManageOnlyProjectTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:GetConsoleOutput",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:810995308548:instance/*",
        "arn:aws:ec2:us-east-1:810995308548:security-group/*"
      ],
      "Condition": { "StringEquals": { "ec2:ResourceTag/Project": "VibeGuard" } }
    },
    {
      "Sid": "Ec2ProjectKeyPairsOnly",
      "Effect": "Allow",
      "Action": ["ec2:CreateKeyPair", "ec2:DeleteKeyPair"],
      "Resource": "arn:aws:ec2:us-east-1:810995308548:key-pair/vibeguard-*"
    },
    {
      "Sid": "ResolveCanonicalUbuntuAmi",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-1::parameter/aws/service/canonical/*"
    },
    {
      "Sid": "S3ListOwnBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "S3ProjectBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketOwnershipControls",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::vibeguard-cloud-2026-*"
    },
    {
      "Sid": "S3ProjectObjectsReadWriteDelete",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::vibeguard-cloud-2026-*/*"
    },
    {
      "Sid": "S3DenyAnyPublicExposure",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:PutBucketAcl",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl"
      ],
      "Resource": [
        "arn:aws:s3:::vibeguard-cloud-2026-*",
        "arn:aws:s3:::vibeguard-cloud-2026-*/*"
      ]
    },
    {
      "Sid": "IamManageOnlyVibeGuardRoleAndInstanceProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::810995308548:role/VibeGuardEC2Role",
        "arn:aws:iam::810995308548:instance-profile/VibeGuardEC2Role"
      ]
    },
    {
      "Sid": "IamPassOnlyVibeGuardRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::810995308548:role/VibeGuardEC2Role",
      "Condition": { "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" } }
    },
    {
      "Sid": "IamReadOnlyVerification",
      "Effect": "Allow",
      "Action": ["iam:GetAccountSummary", "iam:ListRoles", "iam:ListInstanceProfiles"],
      "Resource": "*"
    },
    {
      "Sid": "BudgetsProjectBudgetsOnly",
      "Effect": "Allow",
      "Action": ["budgets:ViewBudget", "budgets:ModifyBudget"],
      "Resource": "arn:aws:budgets::810995308548:budget/VibeGuard-*"
    },
    {
      "Sid": "BudgetsListForVerification",
      "Effect": "Allow",
      "Action": "budgets:ViewBudget",
      "Resource": "arn:aws:budgets::810995308548:budget/*"
    },
    {
      "Sid": "FreeTierAndCostReadOnly",
      "Effect": "Allow",
      "Action": [
        "freetier:GetAccountPlanState",
        "freetier:GetFreeTierUsage",
        "freetier:ListAccountActivities",
        "ce:GetCostAndUsage"
      ],
      "Resource": "*"
    }
  ]
}
